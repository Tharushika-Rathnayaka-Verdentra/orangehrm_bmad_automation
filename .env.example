# Copy to `.env` and adjust if you target a different OrangeHRM instance.
# All values are optional; the public demo defaults below are used when unset.

# Root of the OrangeHRM instance (no trailing slash).
BASE_URL=https://opensource-demo.orangehrmlive.com

# Credentials published on the demo login page.
ORANGEHRM_USERNAME=Admin
ORANGEHRM_PASSWORD=admin123
